# Copy to .env and fill in before `docker compose up`. The file is git-ignored.

# Database credentials for the Compose stack (the backend derives DATABASE_URL).
POSTGRES_USER=rfq
POSTGRES_PASSWORD=
POSTGRES_DB=rfqplanner

# Host port of the web tier.
FRONTEND_PORT=8080

# Leave empty unless the app is served from another origin than the API.
CORS_ORIGINS=

# Name of the header your authenticating reverse proxy sets after login
# (e.g. X-Forwarded-User). Empty means the API does not check it.
TRUSTED_PROXY_USER_HEADER=
